{
  "hosting": {
    "public": "frontend/storefront",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/admin",
        "destination": "/admin/admin.html"
      },
      {
        "source": "/admin.html",
        "destination": "/admin/admin.html"
      }
    ]
  },
  "functions": {
    "source": "backend",
    "runtime": "nodejs20"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}